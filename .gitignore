.superpowers/

# Node
node_modules/
dist/

# Rust / Tauri
src-tauri/target/
src-tauri/gen/

# OS
Thumbs.db
.DS_Store

# Test screenshots
*.png
# …but allow the in-tree showcase gallery to ship (overrides *.png above)
!docs/screenshots/
!docs/screenshots/**

# App icons ship in-tree (tauri build requires them; the blanket *.png above
# would 404 them for cloners, breaking the build and the README logo)
!src-tauri/icons/
!src-tauri/icons/*.png

# Spine character assets ship in-tree (overrides *.png above)
!public/spine/
!public/spine/**

# User config (contains API key — never commit!)
config.toml

# Database
*.db
*.db-wal
*.db-shm

# Model weights
*.onnx
onnxruntime.dll

# CodeGraph index (regenerable via `codegraph init`)
.codegraph/

# Run logs / harness reports
*.log
*_report.txt

# Throwaway debug/edit scripts (not product source)
_*.cjs
_*.py
_*.ps1
edit_*.mjs
shot.ps1
kimi_vision.ps1
screenshot.mjs
e2e-chat-test.mjs
